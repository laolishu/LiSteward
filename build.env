# build.env - 编译配置文件
# 这个文件用于存储编译时的参数，可以被编译脚本读取

# 应用版本号
VERSION=1.0.0

# 作者信息
AUTHOR=Your Name
AUTHOR_EMAIL=your.email@example.com

# 项目信息
REPOSITORY=https://github.com/yourname/listeward
DESCRIPTION=LiSteward - A lightweight hosts file manager

# 构建输出
BUILD_OUTPUT=build/bin/LiSteward.exe

# 使用示例：
# Linux/Mac:
#   source build.env
#   go build -ldflags "-X LiSteward/internal/version.Version=$VERSION ..."
#
# Windows PowerShell:
#   Get-Content build.env | ForEach-Object { ... }
